      <trkpt lat="49.00720" lon="7.0000"><ele>221.0</ele><time>2026-11-19T08:02:24Z</time><extensions><power>60</power><gpxtpx:TrackPointExtension><gpxtpx:hr>110</gpxtpx:hr><gpxtpx:cad>70</gpxtpx:cad></gpxtpx:TrackPointExtension></extensions></trkpt>
      <trkpt lat="49.00765" lon="7.0000"><ele>219.5</ele><time>2026-11-19T08:02:33Z</time><extensions><power>60</power><gpxtpx:TrackPointExtension><gpxtpx:hr>110</gpxtpx:hr><gpxtpx:cad>70</gpxtpx:cad></gpxtpx:TrackPointExtension></extensions></trkpt>
      <trkpt lat="49.00810" lon="7.0000"><ele>218.0</ele><time>2026-11-19T08:02:42Z</time><extensions><power>60</power><gpxtpx:TrackPointExtension><gpxtpx:hr>110</gpxtpx:hr><gpxtpx:cad>70</gpxtpx:cad></gpxtpx:TrackPointExtension></extensions></trkpt>
      <trkpt lat="49.00855" lon="7.0000"><ele>216.5</ele><time>2026-11-19T08:02:51Z</time><extensions><power>60</power><gpxtpx:TrackPointExtension><gpxtpx:hr>110</gpxtpx:hr><gpxtpx:cad>70</gpxtpx:cad></gpxtpx:TrackPointExtension></extensions></trkpt>
      <trkpt lat="49.00900" lon="7.0000"><ele>215.0</ele><time>2026-11-19T08:03:00Z</time><extensions><power>60</power><gpxtpx:TrackPointExtension><gpxtpx:hr>110</gpxtpx:hr><gpxtpx:cad>70</gpxtpx:cad></gpxtpx:TrackPointExtension></extensions></trkpt>
    </trkseg>
  </trk>
</gpx>
