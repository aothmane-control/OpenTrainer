<?xml version="1.0" encoding="utf-8"?>
<network-security-config>
    <!-- No cleartext (HTTP) traffic: the only network access is OpenStreetMap
         map tiles, which osmdroid's MAPNIK source loads over HTTPS -->
    <base-config cleartextTrafficPermitted="false">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
</network-security-config>
